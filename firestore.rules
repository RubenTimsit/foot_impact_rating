rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==================== FONCTIONS UTILITAIRES ====================

    // Vérifie que l'utilisateur est connecté
    function isAuth() {
      return request.auth != null;
    }

    // Vérifie que l'utilisateur accède à sa propre ressource
    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    // Vérifie si l'utilisateur est membre actif d'un groupe
    function isMembre(groupeId) {
      return isAuth() && exists(/databases/$(database)/documents/groupes/$(groupeId)/joueurs/$(request.auth.uid));
    }

    // Vérifie si l'utilisateur est admin d'un groupe
    function isAdminGroupe(groupeId) {
      return isAuth() && get(/databases/$(database)/documents/groupes/$(groupeId)).data.adminId == request.auth.uid;
    }

    // ==================== COLLECTION ADMINS ====================
    // Chaque utilisateur ne peut lire QUE son propre document admin
    // Personne ne peut écrire (géré uniquement via Firebase Console)

    match /admins/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // ==================== COLLECTION USERS ====================
    // Chaque joueur peut lire et écrire son propre profil

    match /users/{userId} {
      allow read: if isAuth();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if false;
    }

    // ==================== COLLECTION GROUPES ====================

    match /groupes/{groupeId} {
      // Tout le monde connecté peut lire les groupes (pour vérifier les codes)
      allow read: if isAuth();

      // Tout utilisateur connecté peut créer un groupe (il en devient l'admin)
      allow create: if isAuth() && request.resource.data.adminId == request.auth.uid;

      // Seul l'admin du groupe peut modifier le groupe
      allow update: if isAdminGroupe(groupeId);
      allow delete: if false;

      // ==================== SOUS-COLLECTION JOUEURS (membres du groupe) ====================
      match /joueurs/{joueurId} {
        // Les membres peuvent lire la liste
        allow read: if isAuth();

        // Un utilisateur connecté peut créer sa propre demande d'adhésion
        allow create: if isOwner(joueurId);

        // L'admin peut modifier le statut (valider/refuser), le joueur peut se mettre à jour lui-même
        allow update: if isAdminGroupe(groupeId) || isOwner(joueurId);
        allow delete: if isAdminGroupe(groupeId);
      }

      // ==================== SOUS-COLLECTION MATCHS ====================
      match /matchs/{matchId} {
        // Les membres actifs peuvent lire les matchs
        allow read: if isAuth();

        // Seul l'admin peut créer/modifier/supprimer des matchs
        allow write: if isAdminGroupe(groupeId);
      }

      // ==================== SOUS-COLLECTION SYNERGIES ====================
      match /synergies/{synergieId} {
        allow read: if isAuth();
        allow write: if isAdminGroupe(groupeId);
      }

      // ==================== SOUS-COLLECTION MATCHS SEMAINE ====================
      match /matchs_semaine/{matchId} {
        allow read: if isAuth();

        // L'admin peut créer/supprimer un créneau
        allow create, delete: if isAdminGroupe(groupeId);

        // L'admin OU un membre actif peut mettre à jour
        // (les membres mettent à jour confirmedCount lors d'inscription/annulation)
        allow update: if isAdminGroupe(groupeId) || isMembre(groupeId);

        // ==================== INSCRIPTIONS ====================
        match /inscriptions/{uid} {
          allow read: if isMembre(groupeId);

          // Un joueur peut s'inscrire lui-même si il est membre actif
          allow create: if isOwner(uid) && isMembre(groupeId);

          // Un joueur peut annuler sa propre inscription
          allow delete: if isOwner(uid) && isMembre(groupeId);
        }
      }
    }
  }
}
