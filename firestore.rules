rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==================== FONCTIONS UTILITAIRES ====================

    // Vérifie que l'utilisateur est connecté
    function isAuth() {
      return request.auth != null;
    }

    // Vérifie que l'utilisateur accède à sa propre ressource
    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    // Vérifie si l'utilisateur est membre actif (statut: 'active') d'un groupe
    function isMembre(groupeId) {
      return isAuth() &&
        get(/databases/$(database)/documents/groupes/$(groupeId)/joueurs/$(request.auth.uid)).data.statut == 'active';
    }

    // Vérifie si l'utilisateur est admin d'un groupe
    function isAdminGroupe(groupeId) {
      return isAuth() && get(/databases/$(database)/documents/groupes/$(groupeId)).data.adminId == request.auth.uid;
    }

    // Vérifie si l'utilisateur est super admin (champ superAdmin == true dans admins/{uid})
    // Le super admin peut administrer n'importe quel groupe.
    function isSuperAdmin() {
      return isAuth() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.superAdmin == true;
    }

    // Raccourci : admin du groupe OU super admin
    function isAdminOrSuper(groupeId) {
      return isAdminGroupe(groupeId) || isSuperAdmin();
    }

    // Vérifie qu'un vote est valide (votant présent au match, vote non clos)
    function voteIsValid(groupeId, matchId) {
      let m = get(/databases/$(database)/documents/groupes/$(groupeId)/matchs/$(matchId)).data;
      return m.voteClos == false &&
        ((m.equipeA is list && request.auth.uid in m.equipeA) ||
         (m.equipeB is list && request.auth.uid in m.equipeB));
    }

    // ==================== COLLECTION ADMINS ====================
    // Chaque utilisateur ne peut lire QUE son propre document admin
    // Personne ne peut écrire (géré uniquement via Firebase Console)

    match /admins/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // ==================== COLLECTION USERS ====================
    // Chaque joueur peut lire et écrire son propre profil

    match /users/{userId} {
      allow read: if isAuth();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if false;
    }

    // ==================== COLLECTION GROUPES ====================

    match /groupes/{groupeId} {
      // Tout le monde connecté peut lire les groupes (pour vérifier les codes)
      allow read: if isAuth();

      // Tout utilisateur connecté peut créer un groupe (il en devient l'admin)
      allow create: if isAuth() && request.resource.data.adminId == request.auth.uid;

      // L'admin du groupe ou le super admin peut modifier le groupe
      allow update: if isAdminOrSuper(groupeId);
      allow delete: if false;

      // ==================== SOUS-COLLECTION JOUEURS (membres du groupe) ====================
      match /joueurs/{joueurId} {
        // Les membres peuvent lire la liste
        allow read: if isAuth();

        // Un utilisateur peut créer sa propre fiche dans un groupe.
        // Stats forcées à 0, rating à 1000. Le statut 'active' n'est autorisé que pour
        // le créateur du groupe (cas de l'auto-inscription admin). Sinon : 'pending'.
        allow create: if isOwner(joueurId) &&
          request.resource.data.impactRating == 1000 &&
          request.resource.data.matchsJoues == 0 &&
          request.resource.data.victoires == 0 &&
          request.resource.data.nuls == 0 &&
          request.resource.data.defaites == 0 &&
          (
            request.resource.data.statut == 'pending' ||
            (request.resource.data.statut == 'active' && isAdminGroupe(groupeId))
          );

        // L'admin (ou super admin) peut tout modifier (validation, stats, rating, trophées via CF)
        // Un joueur ne peut mettre à jour QUE votesParticipes sur son propre doc
        allow update: if isAdminOrSuper(groupeId) ||
          (isOwner(joueurId) &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votesParticipes']));

        allow delete: if isAdminOrSuper(groupeId);
      }

      // ==================== SOUS-COLLECTION MATCHS ====================
      match /matchs/{matchId} {
        // Les membres actifs peuvent lire les matchs
        allow read: if isAuth();

        // Seul l'admin ou le super admin peut créer/supprimer un match
        allow create, delete: if isAdminOrSuper(groupeId);

        // L'admin peut tout modifier ; un membre actif ne peut incrémenter que nbVotes (pour le vote)
        allow update: if isAdminOrSuper(groupeId) ||
          (isMembre(groupeId) &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nbVotes']));
      }

      // ==================== SOUS-COLLECTION SYNERGIES ====================
      match /synergies/{synergieId} {
        allow read: if isAuth();
        allow write: if isAdminOrSuper(groupeId);
      }

      // ==================== SOUS-COLLECTION MATCHS SEMAINE ====================
      match /matchs_semaine/{matchId} {
        allow read: if isAuth();

        // L'admin peut créer/supprimer un créneau
        allow create, delete: if isAdminOrSuper(groupeId);

        // L'admin peut tout modifier ; un membre actif ne peut modifier QUE confirmedCount
        // (incrément à l'inscription / décrément à la désinscription, depuis le client).
        allow update: if isAdminOrSuper(groupeId) ||
          (isMembre(groupeId) &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['confirmedCount']));

        // ==================== INSCRIPTIONS ====================
        match /inscriptions/{uid} {
          allow read: if isMembre(groupeId);

          // Un joueur peut s'inscrire lui-même. uid doit correspondre à l'auth, statut limité
          // à 'confirmé' (place dispo) ou 'attente' (liste d'attente).
          allow create: if isOwner(uid) && isMembre(groupeId) &&
            request.resource.data.uid == request.auth.uid &&
            request.resource.data.statut in ['confirmé', 'attente'];

          // Un joueur peut annuler sa propre inscription
          allow delete: if isOwner(uid) && isMembre(groupeId);
        }
      }

      // ==================== SOUS-COLLECTION VOTES (man of the match) ====================
      // Le path complet est /groupes/{groupeId}/matchs/{matchId}/votes/{votantId}
      match /matchs/{matchId}/votes/{votantId} {
        // Tout membre actif peut lire les votes
        // (TODO P1 : passer en owner-only pour un scrutin secret)
        allow read: if isMembre(groupeId);

        // Un joueur peut voter une seule fois (immutabilité via update/delete false).
        // Validation côté serveur : top distincts, votant != tops, votant présent au match,
        // vote non clos.
        allow create: if isOwner(votantId) && isMembre(groupeId) &&
          request.resource.data.top1 is string &&
          request.resource.data.top2 is string &&
          request.resource.data.top3 is string &&
          request.resource.data.top1 != request.auth.uid &&
          request.resource.data.top2 != request.auth.uid &&
          request.resource.data.top3 != request.auth.uid &&
          request.resource.data.top1 != request.resource.data.top2 &&
          request.resource.data.top1 != request.resource.data.top3 &&
          request.resource.data.top2 != request.resource.data.top3 &&
          voteIsValid(groupeId, matchId);

        // Les votes sont immuables
        allow update, delete: if false;
      }
    }
  }
}
